{
  "name": "@sentropic/h2a",
  "version": "0.98.7",
  "description": "h2a — the unified CLI + core for human-to-agent coordination.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "h2a",
    "human-in-the-loop",
    "multi-agent",
    "coordination",
    "negotiation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/h2a.git",
    "directory": "packages/h2a"
  },
  "homepage": "https://github.com/rhanka/h2a#readme",
  "bugs": {
    "url": "https://github.com/rhanka/h2a/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agy-claude": {
      "types": "./dist/runtime/agy-claude.d.ts",
      "import": "./dist/runtime/agy-claude.js"
    }
  },
  "files": [
    ".claude-plugin",
    ".codex-plugin",
    ".mcp.json",
    "dist",
    "fixtures",
    "skills",
    "schema",
    "focus-app",
    "hooks",
    "scripts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "h2a": "dist/bin.js"
  },
  "scripts": {
    "build": "node ../../scripts/clean-workspace-dist.mjs && tsc -b --force && node ../../scripts/copy-vendored-engram-live.mjs",
    "prepack": "node ../../scripts/check-focus-app.mjs && chmod +x dist/bin.js",
    "prepack": "node ../../scripts/check-focus-app.mjs && node ../../scripts/check-publish-payload.mjs && chmod +x dist/bin.js"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.0",
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sentropic/cluster-mesh": "0.13.3",
    "@sentropic/contracts": "^0.3.0",
    "@sentropic/events": "^0.2.0",
    "@sentropic/track": "0.98.7",
    "hono": "^4.13.7",
    "toml-eslint-parser": "0.10.1"
  },
  "peerDependencies": {
    "@sentropic/h2a-runtime": "0.98.7"
  }
}
