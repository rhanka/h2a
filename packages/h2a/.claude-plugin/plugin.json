{
  "name": "h2a",
  "description": "H2A coordination with one MCP endpoint (including Track read tools) and the H2A, Track, and Harness operating skills.",
  "version": "0.90.1",
  "author": {
    "name": "Fabien Antoine"
  },
  "homepage": "https://github.com/rhanka/h2a/tree/main/packages/h2a#readme",
  "mcpServers": {
    "h2a": {
      "command": "h2a",
      "args": [
        "mcp-serve",
        "--host",
        "claude",
        "--wake",
        "local-tmux",
        "--auto-open",
        "--auto-upgrade"
      ]
    }
  }
}
