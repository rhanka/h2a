{
  "description": "Prevents agents from bypassing the H2A plugin MCP with manual h2a CLI commands.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/deny-manual-h2a-cli.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
