{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sentropic:focus:DecisionDossierDocument:1.0.0",
  "title": "DecisionDossierDocument",
  "description": "Read-only decision-dossier snapshot published by @sentropic/focus. Closed: unknown fields refuse. Snapshot interactions are disabled metadata (enabled:false); live decisions, signatures and amendments require separately qualified runtime capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ref", "subject", "title", "hash", "cursor", "sections", "interactions", "provenance", "amendmentTrace"],
  "properties": {
    "ref": { "type": "string" },
    "subject": { "type": "string" },
    "title": { "type": "string" },
    "hash": { "type": "string" },
    "cursor": { "type": "string" },
    "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } },
    "interactions": { "type": "array", "items": { "$ref": "#/$defs/interaction" } },
    "provenance": { "$ref": "#/$defs/provenance" },
    "amendmentTrace": { "type": "array", "items": { "$ref": "#/$defs/amendmentStep" } }
  },
  "$defs": {
    "section": {
      "oneOf": [
        { "$ref": "#/$defs/proseNode" },
        { "$ref": "#/$defs/questionNode" },
        { "$ref": "#/$defs/optionSetNode" },
        { "$ref": "#/$defs/outcomeNode" },
        { "$ref": "#/$defs/amendmentTraceNode" },
        { "$ref": "#/$defs/diagramNode" }
      ]
    },
    "proseNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "targetRef", "markdown"],
      "properties": {
        "kind": { "const": "prose" },
        "id": { "type": "string" },
        "targetRef": { "type": "string" },
        "markdown": { "type": "string" }
      }
    },
    "questionNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "targetRef", "question", "state"],
      "properties": {
        "kind": { "const": "question" },
        "id": { "type": "string" },
        "targetRef": { "type": "string" },
        "question": { "type": "string" },
        "recommendedAnswer": { "type": "string" },
        "answer": { "type": "string" },
        "state": { "enum": ["open", "answered", "validated"] }
      }
    },
    "optionNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "targetRef", "label", "annotation"],
      "properties": {
        "kind": { "const": "option" },
        "id": { "type": "string" },
        "targetRef": { "type": "string" },
        "label": { "type": "string" },
        "body": { "type": "string" },
        "annotation": { "enum": ["none", "accept", "reject", "comment"] },
        "annotationComment": { "type": "string" }
      }
    },
    "optionSetNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "targetRef", "options"],
      "properties": {
        "kind": { "const": "optionSet" },
        "id": { "type": "string" },
        "targetRef": { "type": "string" },
        "title": { "type": "string" },
        "options": { "type": "array", "items": { "$ref": "#/$defs/optionNode" } }
      }
    },
    "outcomeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "targetRef", "modality", "statement"],
      "properties": {
        "kind": { "const": "outcome" },
        "id": { "type": "string" },
        "targetRef": { "type": "string" },
        "modality": { "enum": ["decision", "orientation", "amendment", "comment"] },
        "statement": { "type": "string" }
      }
    },
    "amendmentTraceNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "targetRef", "steps"],
      "properties": {
        "kind": { "const": "amendmentTrace" },
        "id": { "type": "string" },
        "targetRef": { "type": "string" },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/amendmentStep" } }
      }
    },
    "diagramNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "targetRef", "syntax", "source", "alt"],
      "properties": {
        "kind": { "const": "diagram" },
        "id": { "type": "string" },
        "targetRef": { "type": "string" },
        "syntax": { "enum": ["mermaid", "plantuml"] },
        "source": { "type": "string" },
        "alt": { "type": "string" }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "targetRef", "label", "enabled"],
      "properties": {
        "name": { "type": "string" },
        "targetRef": { "type": "string" },
        "label": { "type": "string" },
        "enabled": { "const": false }
      }
    },
    "comprehensionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "dossierHash"],
      "properties": {
        "subject": { "type": "string" },
        "dossierHash": { "type": "string" },
        "signature": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "readAt"],
      "properties": {
        "source": { "type": "string" },
        "readAt": { "type": "string" },
        "comprehensionEvidence": { "$ref": "#/$defs/comprehensionEvidence" }
      }
    },
    "amendmentStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "author", "summary"],
      "properties": {
        "at": { "type": "string" },
        "author": { "type": "string" },
        "summary": { "type": "string" }
      }
    }
  }
}
