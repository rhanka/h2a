{
  "name": "@sentropic/focus",
  "version": "0.5.0",
  "description": "Focused-session document runtime (FocusSnapshot): the concrete decision-dossier document model + deterministic terminal/MD/HTML renderers + a /track read binding over @sentropic/track/read + a /cli read-only driver (stp focus). Read-only snapshot render-core; markdown injected by the host, HTML sanitized by the host. (Focus-M1 L3)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/h2a.git",
    "directory": "packages/focus"
  },
  "homepage": "https://github.com/rhanka/h2a/tree/main/packages/focus#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./editing": {
      "types": "./dist/editing/index.d.ts",
      "import": "./dist/editing/index.js"
    },
    "./schemas/focus-edit-return.v1": "./schemas/focus-edit-return.v1.schema.json",
    "./schemas/focus-editing-manifest.v1": "./schemas/focus-editing-manifest.v1.schema.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./track": {
      "types": "./dist/track/index.d.ts",
      "import": "./dist/track/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./validate": {
      "types": "./dist/validation/index.d.ts",
      "import": "./dist/validation/index.js"
    },
    "./registry/manifest": "./registry/entries.v1.json",
    "./registry/definitions": {
      "types": "./dist/registry/definitions.d.ts",
      "import": "./dist/registry/definitions.js"
    },
    "./schemas/decision-dossier-document.v1": "./schemas/decision-dossier-document.v1.schema.json",
    "./schemas/decision-dossier-document.v2": "./schemas/decision-dossier-document.v2.schema.json"
  },
  "files": [
    "dist",
    "registry/entries.v1.json",
    "schemas/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build",
    "registry:sync": "node scripts/sync-registry-entry.mjs"
  },
  "dependencies": {
    "@lezer/markdown": "1.8.0",
    "@noble/hashes": "2.0.1",
    "@sentropic/track": "^0.98.6",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
