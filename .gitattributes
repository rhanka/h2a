# focus-vendor is a byte-for-byte tsc snapshot — never let git EOL-convert it (breaks Windows CI drift check)
packages/track/src/focus-vendor/** -text
# Focus source bytes feed the packaged-app hash; keep its textual inputs stable across OS checkouts.
apps/focus/package.json text eol=lf
apps/focus/package-lock.json text eol=lf
apps/focus/svelte.config.js text eol=lf
apps/focus/tsconfig.json text eol=lf
apps/focus/vite.config.ts text eol=lf
apps/focus/src/**/*.css text eol=lf
apps/focus/src/**/*.html text eol=lf
apps/focus/src/**/*.svelte text eol=lf
apps/focus/src/**/*.ts text eol=lf
# Packaged Focus is a byte-hashed production build; preserve generated bytes and suppress textual diff checks.
packages/h2a/focus-app/** -text -diff
