{
  "name": "h2a",
  "private": true,
  "version": "0.85.16",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "!apps/focus"
  ],
  "scripts": {
    "build": "npm run build -w @sentropic/track && tsc -b",
    "build:h2a": "tsc -b",
    "clean": "tsc -b --clean",
    "pack:h2a": "npm pack --dry-run --workspace @sentropic/h2a",
    "pack:h2a-cli": "npm pack --dry-run --workspace @sentropic/h2a-cli",
    "publish:h2a": "npm publish --workspace @sentropic/h2a",
    "publish:h2a-cli": "npm publish --workspace @sentropic/h2a-cli",
    "release": "node scripts/release.mjs",
    "consensus": "node scripts/consensus-review.mjs",
    "trace": "node scripts/track-trace.mjs",
    "vendor:focus": "node scripts/vendor-focus.mjs",
    "check:focus-vendor": "node scripts/check-focus-vendor.mjs",
    "build:focus-app": "node scripts/build-focus-app.mjs",
    "check:focus-app": "node scripts/check-focus-app.mjs",
    "typecheck": "npm run build -w @sentropic/track && tsc -b --pretty false",
    "lint:focus-imports": "node apps/focus/scripts/check-imports.mjs",
    "test": "npm run build && node scripts/check-focus-vendor.mjs && node scripts/check-focus-app.mjs && node apps/focus/scripts/check-imports.mjs && node scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3"
  }
}
