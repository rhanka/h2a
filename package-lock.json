{
  "name": "h2a",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "h2a",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ],
      "devDependencies": {
        "typescript": "^5.9.3"
      }
    },
    "node_modules/@sentropic/h2a": {
      "resolved": "packages/h2a",
      "link": true
    },
    "node_modules/@sentropic/h2a-cli": {
      "resolved": "packages/h2a-cli",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/h2a": {
      "name": "@sentropic/h2a",
      "version": "0.1.0",
      "license": "MIT"
    },
    "packages/h2a-cli": {
      "name": "@sentropic/h2a-cli",
      "version": "0.1.1",
      "license": "MIT",
      "dependencies": {
        "@sentropic/h2a": "^0.1.0"
      },
      "bin": {
        "h2a": "dist/bin.js"
      }
    }
  }
