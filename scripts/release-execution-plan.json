{
  "resolve-release-sha": {
    "runs-on": "ubuntu-latest",
    "outputs": {
      "release-sha": "${{ steps.resolve.outputs.sha }}"
    },
    "steps": [
      {
        "id": "resolve",
        "shell": "bash",
        "run": [
          "set -euo pipefail",
          "if [ \"${{ github.event_name }}\" = \"workflow_dispatch\" ]; then",
          "  tag=\"v${{ inputs.backfill-version }}\"",
          "  remote=\"https://github.com/${GITHUB_REPOSITORY}.git\"",
          "  sha=\"$(git ls-remote \"$remote\" \"refs/tags/${tag}^{}\" | cut -f1)\"",
          "  if [ -z \"$sha\" ]; then",
          "    sha=\"$(git ls-remote \"$remote\" \"refs/tags/${tag}\" | cut -f1)\"",
          "  fi",
          "  if [ -z \"$sha\" ]; then",
          "    echo \"::error::Tag ${tag} does not exist on the remote; refusing to gate or publish it.\" >&2",
          "    exit 1",
          "  fi",
          "else",
          "  sha=\"${GITHUB_SHA}\"",
          "fi",
          "echo \"sha=${sha}\" >> \"$GITHUB_OUTPUT\"",
          "echo \"Resolved release SHA: ${sha}\"",
          ""
        ]
      }
    ]
  },
  "native-recovery": {
    "needs": "resolve-release-sha",
    "uses": "./.github/workflows/native-recovery.yml",
    "with": {
      "ref": "${{ needs.resolve-release-sha.outputs.release-sha }}"
    }
  },
  "verify": {
    "needs": [
      "resolve-release-sha",
      "native-recovery"
    ],
    "runs-on": "${{ matrix.os }}",
    "timeout-minutes": 30,
    "outputs": {
      "release-sha": "${{ needs.resolve-release-sha.outputs.release-sha }}"
    },
    "strategy": {
      "fail-fast": false,
      "matrix": {
        "os": [
          "ubuntu-latest"
        ],
        "node": [
          "22",
          "24"
        ]
      }
    },
    "steps": [
      {
        "uses": "actions/checkout@v4",
        "with": {
          "ref": "${{ needs.resolve-release-sha.outputs.release-sha }}"
        }
      },
      {
        "shell": "bash",
        "run": [
          "set -euo pipefail",
          "git fetch origin main",
          "if ! git merge-base --is-ancestor \"${{ needs.resolve-release-sha.outputs.release-sha }}\" origin/main; then",
          "  echo \"::error::Refusing release: the release commit ${{ needs.resolve-release-sha.outputs.release-sha }} is not on origin/main.\"",
          "  echo \"::error::Create the tag only after the version commit is merged into main.\"",
          "  exit 1",
          "fi",
          ""
        ]
      },
      {
        "uses": "actions/setup-node@v4",
        "with": {
          "node-version": "${{ matrix.node }}",
          "cache": "npm"
        }
      },
      {
        "shell": "bash",
        "run": [
          "set -euo pipefail",
          "node -e 'if (process.versions.node.split(\".\")[0] !== process.argv[1]) process.exit(1)' \"${{ matrix.node }}\"",
          "test \"$(git rev-parse HEAD)\" = \"${{ needs.resolve-release-sha.outputs.release-sha }}\"",
          ""
        ]
      },
      {
        "run": [
          "npm ci"
        ],
        "shell": "bash"
      },
      {
        "run": [
          "npm run audit:security"
        ],
        "shell": "bash"
      },
      {
        "run": [
          "npm run typecheck"
        ],
        "shell": "bash"
      },
      {
        "shell": "bash",
        "run": [
          "npm install --global @openai/codex@0.145.0 @anthropic-ai/claude-code@2.1.296"
        ]
      },
      {
        "shell": "bash",
        "run": [
          "node --test packages/h2a/test/run-test-gates.test.js"
        ]
      },
      {
        "run": [
          "npm test"
        ],
        "shell": "bash"
      },
      {
        "shell": "bash",
        "env": {
          "BACKFILL_VERSION": "${{ inputs.backfill-version }}"
        },
        "run": [
          "node scripts/release-candidate.mjs prepare"
        ]
      },
      {
        "shell": "bash",
        "run": [
          "set -euo pipefail",
          "node scripts/check-lockstep-versions.mjs",
          "mkdir -p dist-tarballs",
          "for pkg in @sentropic/h2a @sentropic/h2a-runtime @sentropic/h2a-cli @sentropic/track @sentropic/focus; do",
          "  npm pack --workspace \"$pkg\" --pack-destination dist-tarballs",
          "done",
          "(cd dist-tarballs && sha256sum *.tgz > sha256sums.txt && cat sha256sums.txt)",
          "# SPEC 0.98.5 R8.2: TIE the artifact manifest to the one resolved",
          "# SHA — the manifest travels with the bytes it describes, and",
          "# publish re-checks it before any npm publish.",
          "echo \"${{ needs.resolve-release-sha.outputs.release-sha }}\" > dist-tarballs/release-sha.txt",
          ""
        ]
      },
      {
        "shell": "bash",
        "run": [
          "npm run smoke:artifact -- --tarballs dist-tarballs"
        ]
      },
      {
        "if": "matrix.node == '22'",
        "uses": "actions/upload-artifact@v4",
        "with": {
          "name": "release-tarballs",
          "path": "dist-tarballs/",
          "if-no-files-found": "error"
        }
      }
    ]
  },
  "publish": {
    "needs": "verify",
    "if": "${{ !cancelled() && !failure() && needs.verify.result == 'success' }}",
    "runs-on": "ubuntu-latest",
    "steps": [
      {
        "uses": "actions/checkout@v4",
        "with": {
          "ref": "${{ needs.verify.outputs.release-sha }}"
        }
      },
      {
        "uses": "actions/download-artifact@v4",
        "with": {
          "name": "release-tarballs",
          "path": "dist-tarballs"
        }
      },
      {
        "shell": "bash",
        "run": [
          "set -euo pipefail",
          "(cd dist-tarballs && sha256sum --check --strict sha256sums.txt)",
          "# SPEC 0.98.5 R8.2: the manifest is TIED to the gated SHA. If these",
          "# bytes were not packed from the exact commit verify gated, refuse.",
          "manifest_sha=\"$(cat dist-tarballs/release-sha.txt)\"",
          "gated_sha=\"${{ needs.verify.outputs.release-sha }}\"",
          "if [ \"$manifest_sha\" != \"$gated_sha\" ]; then",
          "  echo \"::error::Artifact manifest SHA ${manifest_sha} != verify-gated SHA ${gated_sha}; refusing to publish bytes of an ungated commit.\" >&2",
          "  exit 1",
          "fi",
          ""
        ]
      },
      {
        "uses": "actions/setup-node@v4",
        "with": {
          "node-version": "22"
        }
      },
      {
        "shell": "bash",
        "run": [
          "npm install -g npm@^11.15.0"
        ]
      },
      {
        "shell": "bash",
        "env": {
          "BACKFILL_VERSION": "${{ inputs.backfill-version }}"
        },
        "run": [
          "node scripts/release-candidate.mjs prepare"
        ]
      },
      {
        "shell": "bash",
        "env": {
          "GH_TOKEN": "${{ github.token }}",
          "BACKFILL_VERSION": "${{ inputs.backfill-version }}"
        },
        "run": [
          "node scripts/release-candidate.mjs require-rc"
        ]
      },
      {
        "shell": "bash",
        "env": {
          "GITHUB_REF": "${{ github.ref }}",
          "BACKFILL_VERSION": "${{ inputs.backfill-version }}"
        },
        "run": [
          "set -euo pipefail",
          "if [ -n \"${BACKFILL_VERSION:-}\" ]; then",
          "  tag=\"v${BACKFILL_VERSION}\"",
          "else",
          "  tag=\"${GITHUB_REF#refs/tags/}\"",
          "fi",
          "# Strip leading \"v\"",
          "tag_version=\"${tag#v}\"",
          "if [[ ! \"$tag_version\" =~ ^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-rc\\.(0|[1-9][0-9]*))?$ ]]; then",
          "  echo \"::error::Release tag '$tag' does not match vX.Y.Z or vX.Y.Z-rc.N (got version='$tag_version').\" >&2",
          "  exit 1",
          "fi",
          "# SPEC 0.98.5 R8.2: the pinned release SHA resolved by verify in THIS",
          "# run replaces any tag-name resolution here — the tag is mutable, the",
          "# SHA is not, and publish must consume exactly what verify gated.",
          "release_sha=\"${{ needs.verify.outputs.release-sha }}\"",
          "git fetch origin main",
          "if ! git merge-base --is-ancestor \"$release_sha\" origin/main; then",
          "  echo \"::error::Refusing publish: release SHA $release_sha is not on origin/main.\" >&2",
          "  exit 1",
          "fi",
          "node scripts/check-lockstep-versions.mjs",
          "h2a_version=\"$(node -p \"require('./packages/h2a/package.json').version\")\"",
          "cli_version=\"$(node -p \"require('./packages/h2a-cli/package.json').version\")\"",
          "runtime_version=\"$(node -p \"require('./packages/h2a-runtime/package.json').version\")\"",
          "track_version=\"$(node -p \"require('./packages/track/package.json').version\")\"",
          "focus_version=\"$(node -p \"require('./packages/focus/package.json').version\")\"",
          "# A backfill can check out an older four-package prepare helper.",
          "# It cannot authorize publishing focus, even if its old RC gate passes.",
          "if [[ \"$focus_version\" != \"${FOCUS_RELEASE_VERSION:-}\" ]]; then",
          "  echo \"::error::@sentropic/focus was not prepared by the five-package release helper; refusing legacy or mismatched publication.\" >&2",
          "  exit 1",
          "fi",
          "echo \"Tag version           : $tag_version\"",
          "echo \"@sentropic/h2a        : $h2a_version\"",
          "echo \"@sentropic/h2a-cli    : $cli_version\"",
          "echo \"@sentropic/h2a-runtime: $runtime_version\"",
          "echo \"@sentropic/track      : $track_version\"",
          "echo \"@sentropic/focus      : $focus_version (independent version)\"",
          "if [[ \"$h2a_version\" != \"$tag_version\" ]]; then",
          "  echo \"::error::packages/h2a/package.json version ($h2a_version) does not match tag ($tag_version). Run 'npm run release -- --version $tag_version' before tagging.\" >&2",
          "  exit 1",
          "fi",
          "if [[ \"$cli_version\" != \"$tag_version\" ]]; then",
          "  echo \"::error::packages/h2a-cli/package.json version ($cli_version) does not match tag ($tag_version). Run 'npm run release -- --version $tag_version' before tagging.\" >&2",
          "  exit 1",
          "fi",
          "if [[ \"$runtime_version\" != \"$tag_version\" ]]; then",
          "  echo \"::error::packages/h2a-runtime/package.json version ($runtime_version) does not match tag ($tag_version). Run 'npm run release -- --version $tag_version' before tagging.\" >&2",
          "  exit 1",
          "fi",
          "if [[ \"$track_version\" != \"$tag_version\" ]]; then",
          "  echo \"::error::packages/track/package.json version ($track_version) does not match tag ($tag_version). Run 'npm run release -- --version $tag_version' before tagging.\" >&2",
          "  exit 1",
          "fi",
          "echo \"RELEASE_VERSION=$tag_version\" >> \"$GITHUB_ENV\"",
          "echo \"RELEASE_TAG=$tag\" >> \"$GITHUB_ENV\"",
          ""
        ]
      },
      {
        "shell": "bash",
        "run": [
          "v=\"$(node -p \"require('./packages/track/package.json').version\")\"",
          "if npm view \"@sentropic/track@$v\" version >/dev/null 2>&1; then",
          "  echo \"@sentropic/track@$v already on registry; skipping.\"",
          "else",
          "  tagArgs=\"\"",
          "  latest=\"$(npm view \"@sentropic/track\" dist-tags.latest 2>/dev/null || true)\"",
          "  if [ -n \"$latest\" ] && [ \"$v\" != \"$latest\" ]; then",
          "    lowest=\"$(printf '%s\\n%s\\n' \"$v\" \"$latest\" | sort -V | head -n1)\"",
          "    if [ \"$lowest\" = \"$v\" ]; then",
          "      tagArgs=\"--tag backfill\"",
          "      echo \"@sentropic/track@$v is below latest ($latest); publishing with $tagArgs so the latest dist-tag stays untouched.\"",
          "    fi",
          "  fi",
          "  if [[ \"$v\" == *-rc.* ]]; then",
          "    tagArgs=\"--tag next\"",
          "  fi",
          "  # SPEC 0.98.5 R8.2: publish the VERIFIED tarball bytes that verify",
          "  # packed from the gated SHA — never a fresh pack of a mutable ref.",
          "  (cd dist-tarballs && sha256sum --check --strict sha256sums.txt)",
          "  if ! npm publish \"./dist-tarballs/sentropic-track-${v}.tgz\" --access public $tagArgs; then",
          "    echo \"::error::@sentropic/track@$v: npm publish failed (not published).\" >&2",
          "    exit 1",
          "  fi",
          "fi",
          "for attempt in $(seq 1 18); do",
          "  if npm view \"@sentropic/track@$v\" version >/dev/null 2>&1; then",
          "    break",
          "  fi",
          "  if [[ \"$attempt\" -eq 18 ]]; then",
          "    echo \"::warning::@sentropic/track@$v was published but is not visible on registry after 18 attempts — registry propagation lag; not failing the step.\" >&2",
          "    break",
          "  fi",
          "  echo \"@sentropic/track@$v is not visible on registry yet; retrying in 10 seconds (attempt $attempt/18).\" >&2",
          "  sleep 10",
          "done",
          ""
        ]
      },
      {
        "shell": "bash",
        "run": [
          "v=\"$(node -p \"require('./packages/h2a-runtime/package.json').version\")\"",
          "if npm view \"@sentropic/h2a-runtime@$v\" version >/dev/null 2>&1; then",
          "  echo \"@sentropic/h2a-runtime@$v already on registry; skipping.\"",
          "else",
          "  tagArgs=\"\"",
          "  latest=\"$(npm view \"@sentropic/h2a-runtime\" dist-tags.latest 2>/dev/null || true)\"",
          "  if [ -n \"$latest\" ] && [ \"$v\" != \"$latest\" ]; then",
          "    lowest=\"$(printf '%s\\n%s\\n' \"$v\" \"$latest\" | sort -V | head -n1)\"",
          "    if [ \"$lowest\" = \"$v\" ]; then",
          "      tagArgs=\"--tag backfill\"",
          "      echo \"@sentropic/h2a-runtime@$v is below latest ($latest); publishing with $tagArgs so the latest dist-tag stays untouched.\"",
          "    fi",
          "  fi",
          "  if [[ \"$v\" == *-rc.* ]]; then",
          "    tagArgs=\"--tag next\"",
          "  fi",
          "  # SPEC 0.98.5 R8.2: publish the VERIFIED tarball bytes that verify",
          "  # packed from the gated SHA — never a fresh pack of a mutable ref.",
          "  (cd dist-tarballs && sha256sum --check --strict sha256sums.txt)",
          "  if ! npm publish \"./dist-tarballs/sentropic-h2a-runtime-${v}.tgz\" --access public $tagArgs; then",
          "    echo \"::error::@sentropic/h2a-runtime@$v: npm publish failed (not published).\" >&2",
          "    exit 1",
          "  fi",
          "fi",
          "for attempt in $(seq 1 18); do",
          "  if npm view \"@sentropic/h2a-runtime@$v\" version >/dev/null 2>&1; then",
          "    break",
          "  fi",
          "  if [[ \"$attempt\" -eq 18 ]]; then",
          "    echo \"::warning::@sentropic/h2a-runtime@$v was published but is not visible on registry after 18 attempts — registry propagation lag; not failing the step.\" >&2",
          "    break",
          "  fi",
          "  echo \"@sentropic/h2a-runtime@$v is not visible on registry yet; retrying in 10 seconds (attempt $attempt/18).\" >&2",
          "  sleep 10",
          "done",
          ""
        ]
      },
      {
        "shell": "bash",
        "run": [
          "v=\"$(node -p \"require('./packages/h2a/package.json').version\")\"",
          "if npm view \"@sentropic/h2a@$v\" version >/dev/null 2>&1; then",
          "  echo \"@sentropic/h2a@$v already on registry; skipping.\"",
          "else",
          "  tagArgs=\"\"",
          "  latest=\"$(npm view \"@sentropic/h2a\" dist-tags.latest 2>/dev/null || true)\"",
          "  if [ -n \"$latest\" ] && [ \"$v\" != \"$latest\" ]; then",
          "    lowest=\"$(printf '%s\\n%s\\n' \"$v\" \"$latest\" | sort -V | head -n1)\"",
          "    if [ \"$lowest\" = \"$v\" ]; then",
          "      tagArgs=\"--tag backfill\"",
          "      echo \"@sentropic/h2a@$v is below latest ($latest); publishing with $tagArgs so the latest dist-tag stays untouched.\"",
          "    fi",
          "  fi",
          "  if [[ \"$v\" == *-rc.* ]]; then",
          "    tagArgs=\"--tag next\"",
          "  fi",
          "  # SPEC 0.98.5 R8.2: publish the VERIFIED tarball bytes that verify",
          "  # packed from the gated SHA — never a fresh pack of a mutable ref.",
          "  (cd dist-tarballs && sha256sum --check --strict sha256sums.txt)",
          "  if ! npm publish \"./dist-tarballs/sentropic-h2a-${v}.tgz\" --access public $tagArgs; then",
          "    echo \"::error::@sentropic/h2a@$v: npm publish failed (not published).\" >&2",
          "    exit 1",
          "  fi",
          "fi",
          "for attempt in $(seq 1 18); do",
          "  if npm view \"@sentropic/h2a@$v\" version >/dev/null 2>&1; then",
          "    break",
          "  fi",
          "  if [[ \"$attempt\" -eq 18 ]]; then",
          "    echo \"::warning::@sentropic/h2a@$v was published but is not visible on registry after 18 attempts — registry propagation lag; not failing the step.\" >&2",
          "    break",
          "  fi",
          "  echo \"@sentropic/h2a@$v is not visible on registry yet; retrying in 10 seconds (attempt $attempt/18).\" >&2",
          "  sleep 10",
          "done",
          ""
        ]
      },
      {
        "shell": "bash",
        "run": [
          "v=\"$(node -p \"require('./packages/h2a-cli/package.json').version\")\"",
          "if npm view \"@sentropic/h2a-cli@$v\" version >/dev/null 2>&1; then",
          "  echo \"@sentropic/h2a-cli@$v already on registry; skipping.\"",
          "else",
          "  tagArgs=\"\"",
          "  latest=\"$(npm view \"@sentropic/h2a-cli\" dist-tags.latest 2>/dev/null || true)\"",
          "  if [ -n \"$latest\" ] && [ \"$v\" != \"$latest\" ]; then",
          "    lowest=\"$(printf '%s\\n%s\\n' \"$v\" \"$latest\" | sort -V | head -n1)\"",
          "    if [ \"$lowest\" = \"$v\" ]; then",
          "      tagArgs=\"--tag backfill\"",
          "      echo \"@sentropic/h2a-cli@$v is below latest ($latest); publishing with $tagArgs so the latest dist-tag stays untouched.\"",
          "    fi",
          "  fi",
          "  if [[ \"$v\" == *-rc.* ]]; then",
          "    tagArgs=\"--tag next\"",
          "  fi",
          "  # SPEC 0.98.5 R8.2: publish the VERIFIED tarball bytes that verify",
          "  # packed from the gated SHA — never a fresh pack of a mutable ref.",
          "  (cd dist-tarballs && sha256sum --check --strict sha256sums.txt)",
          "  if ! npm publish \"./dist-tarballs/sentropic-h2a-cli-${v}.tgz\" --access public $tagArgs; then",
          "    echo \"::error::@sentropic/h2a-cli@$v: npm publish failed (not published).\" >&2",
          "    exit 1",
          "  fi",
          "fi",
          "for attempt in $(seq 1 18); do",
          "  if npm view \"@sentropic/h2a-cli@$v\" version >/dev/null 2>&1; then",
          "    break",
          "  fi",
          "  if [[ \"$attempt\" -eq 18 ]]; then",
          "    echo \"::warning::@sentropic/h2a-cli@$v was published but is not visible on registry after 18 attempts — registry propagation lag; not failing the step.\" >&2",
          "    break",
          "  fi",
          "  echo \"@sentropic/h2a-cli@$v is not visible on registry yet; retrying in 10 seconds (attempt $attempt/18).\" >&2",
          "  sleep 10",
          "done",
          ""
        ]
      },
      {
        "shell": "bash",
        "run": [
          "v=\"$(node -p \"require('./packages/focus/package.json').version\")\"",
          "if npm view \"@sentropic/focus@$v\" version >/dev/null 2>&1; then",
          "  echo \"@sentropic/focus@$v already on registry; skipping.\"",
          "else",
          "  tagArgs=\"\"",
          "  latest=\"$(npm view \"@sentropic/focus\" dist-tags.latest 2>/dev/null || true)\"",
          "  if [ -n \"$latest\" ] && [ \"$v\" != \"$latest\" ]; then",
          "    lowest=\"$(printf '%s\\n%s\\n' \"$v\" \"$latest\" | sort -V | head -n1)\"",
          "    if [ \"$lowest\" = \"$v\" ]; then",
          "      tagArgs=\"--tag backfill\"",
          "      echo \"@sentropic/focus@$v is below latest ($latest); publishing with $tagArgs so the latest dist-tag stays untouched.\"",
          "    fi",
          "  fi",
          "  if [[ \"$v\" == *-rc.* ]]; then",
          "    tagArgs=\"--tag next\"",
          "  fi",
          "  # SPEC 0.98.5 R8.2: publish the VERIFIED tarball bytes that verify",
          "  # packed from the gated SHA — never a fresh pack of a mutable ref.",
          "  (cd dist-tarballs && sha256sum --check --strict sha256sums.txt)",
          "  if ! npm publish \"./dist-tarballs/sentropic-focus-${v}.tgz\" --access public --provenance $tagArgs; then",
          "    echo \"::error::@sentropic/focus@$v: npm publish failed (not published).\" >&2",
          "    exit 1",
          "  fi",
          "fi",
          "for attempt in $(seq 1 18); do",
          "  if npm view \"@sentropic/focus@$v\" version >/dev/null 2>&1; then",
          "    break",
          "  fi",
          "  if [[ \"$attempt\" -eq 18 ]]; then",
          "    echo \"::warning::@sentropic/focus@$v was published but is not visible on registry after 18 attempts — registry propagation lag; not failing the step.\" >&2",
          "    break",
          "  fi",
          "  echo \"@sentropic/focus@$v is not visible on registry yet; retrying in 10 seconds (attempt $attempt/18).\" >&2",
          "  sleep 10",
          "done",
          ""
        ]
      },
      {
        "env": {
          "GH_TOKEN": "${{ github.token }}"
        },
        "shell": "bash",
        "run": [
          "set -euo pipefail",
          "tag=\"${RELEASE_TAG}\"",
          "if gh release view \"$tag\" >/dev/null 2>&1; then",
          "  echo \"Release $tag already exists; skipping creation.\"",
          "  exit 0",
          "fi",
          "releaseArgs=()",
          "if [[ \"$RELEASE_VERSION\" == *-rc.* ]]; then",
          "  releaseArgs+=(--prerelease --latest=false)",
          "fi",
          "gh release create \"$tag\" \\",
          "  --title \"$tag\" \\",
          "  --generate-notes \\",
          "  --verify-tag \"${releaseArgs[@]}\"",
          ""
        ]
      },
      {
        "id": "post-publish-smoke",
        "shell": "bash",
        "run": [
          "set -euo pipefail",
          "# Post-publish install race: npm installability propagates AFTER visibility",
          "# and later than the old 6x10s=60s budget. Measured on v0.97.6 and v0.97.7:",
          "# ~170s to become visible, and `npm i -g` still failing ETARGET (attempts",
          "# 1..6 over ~42s) on both runs, while `npm view` had already succeeded and",
          "# npm now serves the version. Installability lags visibility, so aligning the",
          "# budget with the visibility checks (18x10s=180s) is a MINIMUM, not",
          "# necessarily sufficient — which is why the overflow is non-blocking below.",
          "max_attempts=18",
          "retry_delay_seconds=10",
          "installed=0",
          "for attempt in $(seq 1 \"$max_attempts\"); do",
          "  if npm i -g \"@sentropic/h2a@$RELEASE_VERSION\"; then",
          "    installed=1",
          "    break",
          "  fi",
          "  echo \"@sentropic/h2a@$RELEASE_VERSION is not installable yet; retrying in $retry_delay_seconds seconds (attempt $attempt/$max_attempts).\" >&2",
          "  sleep \"$retry_delay_seconds\"",
          "done",
          "if [[ \"$installed\" -ne 1 ]]; then",
          "  # RC promotion requires a completed install, never a warning-only pass.",
          "  if [[ \"$RELEASE_VERSION\" == *-rc.* ]]; then",
          "    echo \"::error::RC install smoke did not complete; refusing RC attestation.\" >&2",
          "    exit 1",
          "  fi",
          "  # Positive control (same method as #283: keep a hard-fail path for the real",
          "  # failure). The authoritative \"did we publish\" signal is the return code of",
          "  # `npm publish`, already made blocking upstream by #283 (`npm publish ... ||",
          "  # exit 1`); by the time this step runs, publication is already proven. This",
          "  # `npm view` is a DEFENSIVE GUARD, not the source of truth. It distinguishes",
          "  # \"never published\" from \"published but not yet installable\": if the version",
          "  # is NOT visible on the registry -> HARD FAIL, so this step can still say",
          "  # \"nothing shipped\". If it IS visible, this is pure installability",
          "  # propagation lag on an already-successful publish -> warn, never paint a",
          "  # delivered release red.",
          "  if npm view \"@sentropic/h2a@$RELEASE_VERSION\" version >/dev/null 2>&1; then",
          "    echo \"::warning::@sentropic/h2a@$RELEASE_VERSION is visible on the registry but not installable after $max_attempts attempts — installability propagation lag; publication already succeeded, not failing the step. NOTE: the post-release doctor verification did not run for this release.\" >&2",
          "    exit 0",
          "  fi",
          "  echo \"::error::@sentropic/h2a@$RELEASE_VERSION is neither installable nor visible on the registry after $max_attempts attempts — treating as a publication failure.\" >&2",
          "  exit 1",
          "fi",
          "root=\"$(mktemp -d)/.h2a\"",
          "# Initialize the bus so doctor can inspect host installations instead of",
          "# failing only on a missing root/schema. --repair --dry-run reports host",
          "# findings and planned actions without mutating the runner.",
          "h2a init --root \"$root\" >/dev/null",
          "# Capture stdout even when doctor reports host-health findings; the node",
          "# check below decides from report content.",
          "out=\"$(h2a doctor --root \"$root\" --repair --dry-run --format json 2>/dev/null || true)\"",
          "node -e '",
          "  const hasOwn = (value, key) => Object.prototype.hasOwnProperty.call(value, key);",
          "  let report;",
          "  try {",
          "    report = JSON.parse(process.argv[1]);",
          "  } catch {",
          "    process.exit(1);",
          "  }",
          "  if (",
          "    report === null ||",
          "    typeof report !== \"object\" ||",
          "    !hasOwn(report, \"ok\") ||",
          "    typeof report.ok !== \"boolean\"",
          "  ) {",
          "    process.exit(1);",
          "  }",
          "  if (report.ok === true) process.exit(0);",
          "",
          "  let unrepaired;",
          "  if (hasOwn(report, \"unrepaired\")) {",
          "    unrepaired = report.unrepaired;",
          "  } else if (",
          "    Array.isArray(report.hosts) &&",
          "    report.hosts.length > 0 &&",
          "    report.hosts.every(",
          "      (host) => host !== null && typeof host === \"object\" && Array.isArray(host.unrepaired)",
          "    )",
          "  ) {",
          "    unrepaired = report.hosts.flatMap((host) => host.unrepaired);",
          "  }",
          "  if (",
          "    !Array.isArray(unrepaired) ||",
          "    unrepaired.length === 0 ||",
          "    unrepaired.some(",
          "      (entry) =>",
          "        entry === null ||",
          "        typeof entry !== \"object\" ||",
          "        !hasOwn(entry, \"code\") ||",
          "        entry.code !== \"host-cli-unreachable\"",
          "    )",
          "  ) {",
          "    process.exit(1);",
          "  }",
          "' \"$out\"",
          "echo \"smoke-passed=true\" >> \"$GITHUB_OUTPUT\"",
          ""
        ]
      },
      {
        "shell": "bash",
        "env": {
          "BACKFILL_VERSION": "${{ inputs.backfill-version }}",
          "RC_SMOKE_PASSED": "${{ steps.post-publish-smoke.outputs.smoke-passed }}"
        },
        "run": [
          "node scripts/release-candidate.mjs attest"
        ]
      },
      {
        "uses": "actions/upload-artifact@v4",
        "with": {
          "name": "release-attestation-${{ github.run_attempt }}",
          "path": "release-attestation/attestation.json",
          "if-no-files-found": "error",
          "retention-days": 90
        }
      }
    ]
  }
}
